{
  "expo": {
    "name": "OOTD",
    "slug": "OOTD",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#59603C",
          "defaultChannel": "ootd-daily-edit"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OOTD to use your location to tailor outfits to your local weather."
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow OOTD to access your calendar to suggest outfits based on your daily events."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OOTD to access your photos to add items to your virtual wardrobe."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Allow OOTD to remind you about your daily outfit edit."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.anonymous.OOTD"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
